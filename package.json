{
  "name": "belajarkode",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Akademi pemrograman mandiri, portabel dalam satu file HTML.",
  "scripts": {
    "dev": "npm run book && vite",
    "build": "npm run content:check && npm run book && vite build && node scripts/release.mjs",
    "content:build": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs && node scripts/check-content.mjs",
    "sources:check": "node scripts/check-sources.mjs",
    "book": "node scripts/build-content.mjs && node scripts/build-book.mjs",
    "extract:book": "node scripts/extract-deep-dive.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:legacy": "node scripts/smoke-legacy.mjs",
    "smoke:guest": "node scripts/smoke-guest.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
